// CSC e-Governance Services India Ltd. - Enterprise ITSM Schema
// Compatible with PostgreSQL / Neon / Supabase / AWS RDS / Self-Hosted

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  EMPLOYEE          // Requester / End User
  SERVICE_DESK      // L1 Service Desk Technician
  L2_ENGINEER       // L2 Technical Support Engineer
  L3_SPECIALIST     // L3 Senior Specialist / Architect
  IT_MANAGER        // IT Operations / Team Manager
  CHANGE_MANAGER    // Change Advisory Board / Manager
  PROBLEM_MANAGER   // Problem & Known Error Manager
  ASSET_MANAGER     // CMDB / IT Asset Manager
  AUDITOR           // Read-only Compliance / ISO Auditor
  ADMIN             // System Administrator
}

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
  ACCESS_REQUEST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Impact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  PENDING
  AWAITING_USER
  AWAITING_APPROVAL
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum SLAState {
  HEALTHY
  AT_RISK
  BREACHED
  MET
}

enum ChangeType {
  STANDARD
  NORMAL
  EMERGENCY
}

enum ChangeStatus {
  DRAFT
  ASSESSMENT
  APPROVAL
  SCHEDULED
  IMPLEMENTATION
  VALIDATION
  COMPLETED
  FAILED
  ROLLED_BACK
  CANCELLED
}

enum ProblemStatus {
  LOGGED
  INVESTIGATING
  ROOT_CAUSE_IDENTIFIED
  WORKAROUND_FOUND
  KNOWN_ERROR
  RESOLVED
  CLOSED
}

enum AssetStatus {
  ACTIVE
  IN_STOCK
  MAINTENANCE
  RETIRED
  DECOMMISSIONED
}

enum AssetType {
  SERVER
  VM
  LAPTOP
  DESKTOP
  NETWORK_SWITCH
  FIREWALL
  ROUTER
  DATABASE
  APPLICATION
  STORAGE
  PRINTER
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  name            String
  employeeCode    String?        @unique
  role            UserRole       @default(EMPLOYEE)
  phone           String?
  departmentId    String?
  locationId      String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  department      Department?    @relation(fields: [departmentId], references: [id])
  location        Location?      @relation(fields: [locationId], references: [id])
  
  requestedTickets Ticket[]      @relation("RequesterTickets")
  assignedTickets  Ticket[]      @relation("AssignedTickets")
  comments         TicketComment[]
  workNotes        TicketWorkNote[]
  tasks            TicketTask[]
  assignedGroups   GroupMember[]
  auditLogs        AuditLog[]
  approvals        ApprovalRequest[]
  ownedChanges     Change[]      @relation("ChangeOwner")
  ownedProblems    Problem[]     @relation("ProblemOwner")
  assignedAssets   Asset[]       @relation("AssetOwner")
}

model Department {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  headName    String?
  users       User[]
  tickets     Ticket[]
  assets      Asset[]
  createdAt   DateTime  @default(now())
}

model Location {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  city        String
  state       String
  isDC        Boolean   @default(false)
  users       User[]
  tickets     Ticket[]
  assets      Asset[]
  createdAt   DateTime  @default(now())
}

model AssignmentGroup {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  email       String?
  leadId      String?
  members     GroupMember[]
  tickets     Ticket[]
  createdAt   DateTime      @default(now())
}

model GroupMember {
  id        String          @id @default(uuid())
  groupId   String
  userId    String
  group     AssignmentGroup @relation(fields: [groupId], references: [id])
  user      User            @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model Category {
  id             String          @id @default(uuid())
  name           String          @unique
  description    String?
  defaultGroupId String?
  subcategories  Subcategory[]
  tickets        Ticket[]
  createdAt      DateTime        @default(now())
}

model Subcategory {
  id          String    @id @default(uuid())
  name        String
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  tickets     Ticket[]
  createdAt   DateTime  @default(now())

  @@unique([categoryId, name])
}

model Ticket {
  id              String          @id @default(uuid())
  ticketNumber    String          @unique
  subject         String
  description     String
  type            TicketType      @default(INCIDENT)
  status          TicketStatus    @default(NEW)
  priority        Priority        @default(MEDIUM)
  impact          Impact          @default(MEDIUM)
  urgency         Urgency         @default(MEDIUM)

  requesterId     String
  requester       User            @relation("RequesterTickets", fields: [requesterId], references: [id])
  
  assignedToId    String?
  assignedTo      User?           @relation("AssignedTickets", fields: [assignedToId], references: [id])
  
  assignmentGroupId String?
  assignmentGroup   AssignmentGroup? @relation(fields: [assignmentGroupId], references: [id])

  departmentId    String?
  department      Department?     @relation(fields: [departmentId], references: [id])

  locationId      String?
  location        Location?       @relation(fields: [locationId], references: [id])

  categoryId      String?
  category        Category?       @relation(fields: [categoryId], references: [id])

  subcategoryId   String?
  subcategory     Subcategory?    @relation(fields: [subcategoryId], references: [id])

  assetId         String?
  asset           Asset?          @relation(fields: [assetId], references: [id])

  problemId       String?
  problem         Problem?        @relation(fields: [problemId], references: [id])

  changeId        String?
  change          Change?         @relation(fields: [changeId], references: [id])

  // SLA tracking
  responseDueDate DateTime?
  respondedAt     DateTime?
  resolutionDueDate DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  reopenedAt      DateTime?
  slaState        SLAState        @default(HEALTHY)

  // Resolution Details
  solution        String?
  solutionAccepted Boolean?
  closeNotes      String?

  // Relations
  comments        TicketComment[]
  workNotes       TicketWorkNote[]
  tasks           TicketTask[]
  attachments     TicketAttachment[]
  timeline        TicketHistory[]
  approvals       ApprovalRequest[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model TicketComment {
  id          String    @id @default(uuid())
  ticketId    String
  authorId    String
  content     String
  isInternal  Boolean   @default(false)
  ipAddress   String?
  createdAt   DateTime  @default(now())

  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id])
}

model TicketWorkNote {
  id          String    @id @default(uuid())
  ticketId    String
  authorId    String
  content     String
  ipAddress   String?
  createdAt   DateTime  @default(now())

  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id])
}

model TicketTask {
  id            String    @id @default(uuid())
  ticketId      String
  title         String
  description   String?
  assignedToId  String?
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  dueDate       DateTime?
  createdAt     DateTime  @default(now())

  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignedTo    User?     @relation(fields: [assignedToId], references: [id])
}

model TicketAttachment {
  id          String    @id @default(uuid())
  ticketId    String
  fileName    String
  fileSize    Int
  fileType    String
  storageKey  String
  uploadedBy  String
  createdAt   DateTime  @default(now())

  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model TicketHistory {
  id          String    @id @default(uuid())
  ticketId    String
  userId      String?
  userName    String
  action      String
  fieldName   String?
  oldValue    String?
  newValue    String?
  comment     String?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model SLADefinition {
  id              String    @id @default(uuid())
  name            String
  priority        Priority  @unique
  responseMinutes Int       // Response SLA in minutes
  resolveMinutes  Int       // Resolution SLA in minutes
  businessHoursOnly Boolean @default(true)
  escLevel1Minutes Int?
  escLevel2Minutes Int?
  escLevel3Minutes Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  ticketId        String?
  changeId        String?
  accessRequestId String?
  title           String
  description     String?
  stage           Int            @default(1)
  approverRole    UserRole       @default(IT_MANAGER)
  approverId      String?
  status          ApprovalStatus @default(PENDING)
  comments        String?
  actionedAt      DateTime?
  createdAt       DateTime       @default(now())

  ticket          Ticket?        @relation(fields: [ticketId], references: [id])
  change          Change?        @relation(fields: [changeId], references: [id])
  approver        User?          @relation(fields: [approverId], references: [id])
}

model Change {
  id                  String         @id @default(uuid())
  changeNumber        String         @unique
  title               String
  description         String
  type                ChangeType     @default(NORMAL)
  status              ChangeStatus   @default(DRAFT)
  riskLevel           String         @default("MEDIUM")
  impactLevel         String         @default("MEDIUM")
  justification       String
  implementationPlan  String
  rollbackPlan        String
  testingPlan         String
  plannedStartTime    DateTime
  plannedEndTime      DateTime
  actualStartTime     DateTime?
  actualEndTime       DateTime?
  ownerId             String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  owner               User           @relation("ChangeOwner", fields: [ownerId], references: [id])
  tickets             Ticket[]
  approvals           ApprovalRequest[]
}

model Problem {
  id                  String         @id @default(uuid())
  problemNumber       String         @unique
  title               String
  description         String
  status              ProblemStatus  @default(LOGGED)
  impact              Impact         @default(MEDIUM)
  rootCause           String?
  workaround          String?
  correctiveAction    String?
  preventiveAction    String?
  ownerId             String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  owner               User           @relation("ProblemOwner", fields: [ownerId], references: [id])
  relatedTickets      Ticket[]
}

model Asset {
  id              String      @id @default(uuid())
  assetTag        String      @unique
  name            String
  type            AssetType   @default(SERVER)
  status          AssetStatus @default(ACTIVE)
  serialNumber    String?
  ipAddress       String?
  hostname        String?
  vendor          String?
  model           String?
  departmentId    String?
  locationId      String?
  ownerId         String?
  purchaseDate    DateTime?
  warrantyExpiry  DateTime?
  specs           String?     // JSON or description
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  department      Department? @relation(fields: [departmentId], references: [id])
  location        Location?   @relation(fields: [locationId], references: [id])
  owner           User?       @relation("AssetOwner", fields: [ownerId], references: [id])
  tickets         Ticket[]
}

model KnowledgeArticle {
  id          String    @id @default(uuid())
  articleCode String    @unique
  title       String
  category    String    // SOP, Troubleshooting, How-To, FAQ, Security
  content     String
  summary     String?
  authorName  String
  version     String    @default("1.0")
  isPublished Boolean   @default(true)
  viewCount   Int       @default(0)
  reviewDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id          String    @id @default(uuid())
  timestamp   DateTime  @default(now())
  userId      String?
  userName    String
  userRole    String
  action      String    // LOGIN, CREATE, UPDATE, ASSIGN, STATUS_CHANGE, APPROVE, REJECT
  module      String    // TICKETS, USERS, ASSETS, CHANGES, PROBLEMS, ADMIN, ACCESS_REQUESTS
  objectType  String    // Ticket, User, Asset, Change, Setting
  objectId    String
  oldValue    String?
  newValue    String?
  details     String?
  ipAddress   String    @default("127.0.0.1")
  userAgent   String?

  user        User?     @relation(fields: [userId], references: [id])
}

model SystemSetting {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String    // JSON stringified configuration
  description String?
  updatedAt   DateTime  @updatedAt
}
