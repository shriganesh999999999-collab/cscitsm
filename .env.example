# Application Settings
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Neon / Supabase / Self-Hosted)
DATABASE_URL=postgresql://postgres:password@localhost:5432/csc_itsm?schema=public

# Authentication Secrets
AUTH_SECRET=csc_itsm_super_secure_auth_secret_token_change_in_production
JWT_EXPIRES_IN=7d

# Email / SMTP Notification Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CSC ITSM Portal <itsm-noreply@csc.gov.in>"

# WhatsApp Business / Enterprise Gateway API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=CSC_ITSM

# Object Storage for Ticket Attachments (S3 / MinIO / Vercel Blob)
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=csc-itsm-attachments
BLOB_READ_WRITE_TOKEN=

# Optional AI Assistance
GEMINI_API_KEY=

